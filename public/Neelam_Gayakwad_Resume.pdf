 text-muted-foreground\"\u003eAuthentication, database, and hosting\u003c/p\u003e\n                \u003c/div\u003e\n\n                {/* Duplicate set for seamless loop */}\n                \u003cdiv className=\"skill-card-sliding featured\"\u003e\n                  \u003cdiv className=\"flex items-center gap-3 mb-3\"\u003e\n                    \u003cdiv className=\"w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center\"\u003e\n                      \u003cCode className=\"h-5 w-5\" /\u003e\n                    \u003c/div\u003e\n                    \u003cdiv\u003e\n                      \u003ch4 className=\"font-bold text-lg\"\u003eReact Native\u003c/h4\u003e\n                      \u003cp className=\"text-sm opacity-90\"\u003eMobile Development\u003c/p\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"w-full bg-white/20 rounded-full h-2 mb-2\"\u003e\n                    \u003cdiv className=\"bg-white h-2 rounded-full\" style={{ width: \"80%\" }}\u003e\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cp className=\"text-xs opacity-75\"\u003eCross-platform mobile apps with native performance\u003c/p\u003e\n                \u003c/div\u003e\n\n                \u003cdiv className=\"skill-card-sliding\"\u003e\n                  \u003cdiv className=\"flex items-center gap-3 mb-3\"\u003e\n                    \u003cdiv className=\"w-10 h-10 gradient-github-primary rounded-lg flex items-center justify-center\"\u003e\n                      \u003cCode className=\"h-5 w-5 text-white\" /\u003e\n                    \u003c/div\u003e\n                    \u003cdiv\u003e\n                      \u003ch4 className=\"font-bold text-lg text-foreground\"\u003eReact.js\u003c/h4\u003e\n                      \u003cp className=\"text-sm text-muted-foreground\"\u003eFrontend Framework\u003c/p\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n           