d-cols-4 gap-8\"\u003e\n            {[\"Frontend\", \"Mobile\", \"Backend\", \"Tools\"].map((category, categoryIndex) =\u003e (\n              \u003cdiv\n                key={category}\n                className={`mobile-inspired-skill-card animate-fade-in-up animate-delay-${(categoryIndex + 1) * 100}`}\n              \u003e\n                \u003cdiv className=\"mobile-skill-header\"\u003e\n                  \u003cdiv className=\"mobile-skill-icon\"\u003e\n                    \u003cGitBranch className=\"h-4 w-4 text-accent\" /\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"mobile-skill-category\"\u003e{category}\u003c/div\u003e\n                \u003c/div\u003e\n                \u003cdiv className=\"space-y-3\"\u003e\n                  {skills\n                    .filter((skill) =\u003e skill.category === category)\n                    .map((skill, index) =\u003e (\n                      \u003cdiv key={index} className=\"space-y-2\"\u003e\n                        \u003cdiv className=\"flex justify-between items-center\"\u003e\n                          \u003cspan className=\"skill-badge\"\u003e{skill.name}\u003c/span\u003e\n                          \u003cspan className=\"text-xs text-muted-foreground\"\u003e{skill.level}%\u003c/span\u003e\n                        \u003c/div\u003e\n                        \u003cdiv className=\"w-full bg-secondary rounded-full h-2\"\u003e\n                          \u003cdiv\n                            className=\"gradient-github-accent h-2 rounded-full transition-all duration-1000 ease-out\"\n                            style={{ width: `${skill.level}%` }}\n                          \u003e\u003c/div\u003e\n                        \u003c/div\u003e\n                      \u003c/div\u003e\n                    ))}\n                \u003c/div\u003e\n              \u003c/div\u003e\n            ))}\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003csection id=\"experience\" className=\"py-20 px-4 sm:px-6 lg:px-8\"\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto\"\u003e\n          \u003cdiv className=\"text-center mb-16\"\u003e\n            \u003ch2 className=\"text-3xl md:text-5xl font-bold text-foreground mb-4\"\u003e\n              \u003cspan className=\"gradient-text-github\"\u003eWork Experience\u003c/span\u003e\n            \u003c/h2\u003e\n            \u003cp className=\"text-muted-foreground text-lg\"\u003eMy professional journey and achievements\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv className=\"space-y-8\"\u003e\n            {experience.map((exp, index) =\u003e (\n              \u003cdiv key={index} className={`github-card p-8 animate-slide-in-left animate-delay-${(index + 1) * 200}`}\u003e\n                \u003cdiv className=\"flex flex-col md:flex-row md:items-start md:justify-between mb-6\"\u003e\n                  \u003cdiv className=\"flex-1\"\u003e\n                    \u003ch3 className=\"text-2xl font-bold text-foreground mb-2\"\u003e{exp.title}\u003c/h3\u003e\n                    \u003cdiv className=\"flex items-center gap-2 text-accent font-semibold mb-2\"\u003e\n                      \u003cCalendar className=\"h-4 w-4\" /\u003e\n                      {exp.company}\n                    \u003c/div\u003e\n                    \u003cdiv className=\"inline-flex items-center gap-2 bg-accent/10 text-accent px-3 py-1 rounded-full text-sm font-medium\"\u003e\n                      {exp.type}\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"mt-4 md:mt-0\"\u003e\n                    \u003cdiv className=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-lg font-semibold\"\u003e\n                      {exp.period}\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n                \u003cp className=\"text-muted-foreground mb-4 text-lg leading-relaxed\"\u003e{exp.description}\u003c/p\u003e\n                \u003cdiv className=\"flex flex-wrap gap-2\"\u003e\n                  {exp.achievements.map((achievement, achIndex) =\u003e (\n                    \u003cspan key={achIndex} className=\"skill-badge\"\u003e\n                      {achievement}\n                    \u003c/span\u003e\n                  ))}\n                \u003c/div\u003e\n              \u003c/div\u003e\n            ))}\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003csection id=\"projects\" className=\"py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden\"\u003e\n        \u003cdiv className=\"absolute inset-0 hero-gradient-bg opacity-20\"\u003e\u003c/div\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto relative z-10\"\u003e\n          \u003cdiv className=\"text-center mb-16\"\u003e\n            \u003ch2 className=\"text-3xl md:text-5xl font-bold text-foreground mb-4\"\u003e\n              \u003cspan className=\"gradient-text-github\"\u003eFeatured Projects\u003c/span\u003e\n            \u003c/h2\u003e\n            \u003cp className=\"text-muted-foreground text-lg\"\u003eA showcase of my recent work and contributions\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\"\u003e\n            {projects.map((project, index) =\u003e (\n              \u003cdiv key={index} className={`mobile-project-card animate-scale-in animate-delay-${(index + 1) * 100}`}\u003e\n                \u003cdiv className=\"mobile-project-header\"\u003e\n                  \u003cdiv className=\"mobile-project-icon\"\u003e\n                    \u003cCode className=\"h-6 w-6 text-white\" /\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"mobile-project-stats\"\u003e\n                    \u003cdiv className=\"mobile-project-stat\"\u003e\n                      \u003cStar className=\"h-4 w-4\" /\u003e\n                      {project.stars}\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-project-stat\"\u003e\n                      \u003cGitBranch className=\"h-4 w-4\" /\u003e\n                      {project.forks}\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n                \u003ch3 className=\"text-xl font-bold text-foreground mb-3\"\u003e{project.title}\u003c/h3\u003e\n                \u003cp className=\"text-muted-foreground mb-4 leading-relaxed\"\u003e{project.description}\u003c/p\u003e\n                \u003cdiv className=\"flex flex-wrap gap-2 mb-6\"\u003e\n                  {project.technologies.map((tech, techIndex) =\u003e (\n                    \u003cspan key={techIndex} className=\"skill-badge\"\u003e\n                      {tech}\n                    \u003c/span\u003e\n                  ))}\n                \u003c/div\u003e\n                \u003cdiv className=\"flex gap-3\"\u003e\n                  \u003cButton className=\"github-button-secondary flex-1 text-sm\"\u003e\n                    \u003cGithub className=\"mr-2 h-4 w-4\" /\u003e\n                    Code\n                  \u003c/Button\u003e\n                  \u003cButton className=\"github-button flex-1 text-sm\"\u003e\n                    \u003cExternalLink className=\"mr-2 h-4 w-4\" /\u003e\n                    Live\n                  \u003c/Button\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n            ))}\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003csection id=\"contact\" className=\"py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden\"\u003e\n        \u003cdiv className=\"absolute inset-0 gradient-github-dark opacity-40\"\u003e\u003c/div\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto relative z-10\"\u003e\n          \u003cdiv className=\"text-center mb-16\"\u003e\n            \u003ch2 className=\"text-3xl md:text-5xl font-bold text-foreground mb-4\"\u003e\n              \u003cspan className=\"gradient-text-github\"\u003eGet In Touch\u003c/span\u003e\n            \u003c/h2\u003e\n            \u003cp className=\"text-muted-foreground text-lg\"\u003eLet's collaborate and build something amazing together\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv className=\"grid md:grid-cols-2 gap-12\"\u003e\n            \u003cdiv className=\"animate-slide-in-left\"\u003e\n              \u003cdiv className=\"github-card p-8 mb-8\"\u003e\n                \u003ch3 className=\"text-2xl font-bold text-foreground mb-6\"\u003eContact Information\u003c/h3\u003e\n                \u003cdiv className=\"space-y-4\"\u003e\n                  \u003cdiv className=\"flex items-center gap-4 text-muted-foreground hover:text-accent transition-colors\"\u003e\n                    \u003cPhone className=\"h-5 w-5\" /\u003e\n                    \u003cspan\u003e+91-9179304139\u003c/span\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"flex items-center gap-4 text-muted-foreground hover:text-accent transition-colors\"\u003e\n                    \u003cMail className=\"h-5 w-5\" /\u003e\n                    \u003cspan\u003eneelg1805@gmail.com\u003c/span\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"flex items-center gap-4 text-muted-foreground hover:text-accent transition-colors\"\u003e\n                    \u003cMapPin className=\"h-5 w-5\" /\u003e\n                    \u003cspan\u003eVillage Samoda, Dist-Durg (C.G)\u003c/span\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n\n              \u003cdiv className=\"flex gap-4\"\u003e\n                \u003cButton className=\"github-button px-6 py-3\"\u003e\n                  \u003cGithub className=\"mr-2 h-5 w-5\" /\u003e\n                  GitHub\n                \u003c/Button\u003e\n                \u003cButton className=\"github-button-secondary px-6 py-3\"\u003e\n                  \u003cLinkedin className=\"mr-2 h-5 w-5\" /\u003e\n                  LinkedIn\n                \u003c/Button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv className=\"github-card p-8 animate-scale-in animate-delay-300\"\u003e\n              \u003ch3 className=\"text-2xl font-bold text-foreground mb-6\"\u003eSend a Message\u003c/h3\u003e\n              \u003cform onSubmit={handleSubmit} className=\"space-y-6\"\u003e\n                \u003cInput\n                  name=\"name\"\n                  placeholder=\"Your Name\"\n                  value={formData.name}\n                  onChange={handleInputChange}\n                  className=\"bg-input border-border text-foreground placeholder:text-muted-foreground\"\n                  required\n                /\u003e\n                \u003cInput\n                  name=\"email\"\n                  type=\"email\"\n                  placeholder=\"Your Email\"\n                  value={formData.email}\n                  onChange={handleInputChange}\n                  className=\"bg-input border-border text-foreground placeholder:text-muted-foreground\"\n                  required\n                /\u003e\n                \u003cTextarea\n                  name=\"message\"\n                  placeholder=\"Your Message\"\n                  rows={4}\n                  value={formData.message}\n                  onChange={handleInputChange}\n                  className=\"bg-input border-border text-foreground placeholder:text-muted-foreground\"\n                  required\n                /\u003e\n                \u003cButton type=\"submit\" className=\"github-button w-full py-3 font-semibold\"\u003e\n                  Send Message\n                \u003c/Button\u003e\n              \u003c/form\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003cfooter