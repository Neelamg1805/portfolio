f;\n  --secondary: #21262d;\n  --secondary-foreground: #f0f6fc;\n  --muted: #21262d;\n  --muted-foreground: #8b949e;\n  --accent: #a855f7;\n  --accent-foreground: #0d1117;\n  --destructive: #f85149;\n  --destructive-foreground: #ffffff;\n  --border: #30363d;\n  --input: #21262d;\n  --ring: #a855f7;\n  --chart-1: #a855f7;\n  --chart-2: #8b5cf6;\n  --chart-3: #7c3aed;\n  --chart-4: #c084fc;\n  --chart-5: #ddd6fe;\n  --radius: 6px;\n  --sidebar: #161b22;\n  --sidebar-foreground: #f0f6fc;\n  --sidebar-primary: #a855f7;\n  --sidebar-primary-foreground: #0d1117;\n  --sidebar-accent: #21262d;\n  --sidebar-accent-foreground: #f0f6fc;\n  --sidebar-border: #30363d;\n  --sidebar-ring: #a855f7;\n}\n\n.dark {\n  /* Consistent GitHub dark theme tokens with purple accents */\n  --background: #0d1117;\n  --foreground: #f0f6fc;\n  --card: #161b22;\n  --card-foreground: #f0f6fc;\n  --popover: #161b22;\n  --popover-foreground: #f0f6fc;\n  --primary: #8b5cf6;\n  --primary-foreground: #ffffff;\n  --secondary: #21262d;\n  --secondary-foreground: #f0f6fc;\n  --muted: #21262d;\n  --muted-foreground: #8b949e;\n  --accent: #a855f7;\n  --accent-foreground: #0d1117;\n  --destructive: #f85149;\n  --destructive-foreground: #ffffff;\n  --border: #30363d;\n  --input: #21262d;\n  --ring: #a855f7;\n  --chart-1: #a855f7;\n  --chart-2: #8b5cf6;\n  --chart-3: #7c3aed;\n  --chart-4: #c084fc;\n  --chart-5: #ddd6fe;\n  --sidebar: #161b22;\n  --sidebar-foreground: #f0f6fc;\n  --sidebar-primary: #a855f7;\n  --sidebar-primary-foreground: #0d1117;\n  --sidebar-accent: #21262d;\n  --sidebar-accent-foreground: #f0f6fc;\n  --sidebar-border: #30363d;\n  --sidebar-ring: #a855f7;\n}\n\n@theme inline {\n  --color-background: var(--background);\n  --color-foreground: var(--foreground);\n  --color-card: var(--card);\n  --color-card-foreground: var(--card-foreground);\n  --color-popover: var(--popover);\n  --color-popover-foreground: var(--popover-foreground);\n  --color-primary: var(--primary);\n  --color-primary-foreground: var(--primary-foreground);\n  --color-secondary: var(--secondary);\n  --color-secondary-foreground: var(--secondary-foreground);\n  --color-muted: var(--muted);\n  --color-muted-foreground: var(--muted-foreground);\n  --color-accent: var(--accent);\n  --color-accent-foreground: var(--accent-foreground);\n  --color-destructive: var(--destructive);\n  --color-destructive-foreground: var(--destructive-foreground);\n  --color-border: var(--border);\n  --color-input: var(--input);\n  --color-ring: var(--ring);\n  --color-chart-1: var(--chart-1);\n  --color-chart-2: var(--chart-2);\n  --color-chart-3: var(--chart-3);\n  --color-chart-4: var(--chart-4);\n  --color-chart-5: var(--chart-5);\n  --radius-sm: calc(var(--radius) - 4px);\n  --radius-md: calc(var(--radius) - 2px);\n  --radius-lg: var(--radius);\n  --radius-xl: calc(var(--radius) + 4px);\n  --color-sidebar: var(--sidebar);\n  --color-sidebar-foreground: var(--sidebar-foreground);\n  --color-sidebar-primary: var(--sidebar-primary);\n  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);\n  --color-sidebar-accent: var(--sidebar-accent);\n  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);\n  --color-sidebar-border: var(--sidebar-border);\n  --color-sidebar-ring: var(--sidebar-ring);\n}\n\n@layer base {\n  * {\n    @apply border-border outline-ring/50;\n  }\n  body {\n    @apply bg-background text-foreground;\n  }\n}\n\n/* GitHub-inspired animations and effects */\n@layer utilities {\n  /* GitHub-style gradient animations */\n  @keyframes github-gradient {\n    0%,\n    100% {\n      background-position: 0% 50%;\n    }\n    50% {\n      background-position: 100% 50%;\n    }\n  }\n\n  @keyframes github-glow {\n    0%,\n    100% {\n      box-shadow: 0 0 20px rgba(57, 211, 83, 0.3);\n    }\n    50% {\n      box-shadow: 0 0 40px rgba(57, 211, 83, 0.6);\n    }\n  }\n\n  @keyframes fade-in-up {\n    from {\n      opacity: 0;\n      transform: translateY(30px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes slide-in-left {\n    from {\n      opacity: 0;\n      transform: translateX(-50px);\n    }\n    to {\n      opacity: 1;\n      transform: translateX(0);\n    }\n  }\n\n  @keyframes scale-in {\n    from {\n      opacity: 0;\n      transform: scale(0.9);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  @keyframes float {\n    0%,\n    100% {\n      transform: translateY(0px);\n    }\n    50% {\n      transform: translateY(-10px);\n    }\n  }\n\n  @keyframes typing-cursor {\n    0%,\n    50% {\n      opacity: 1;\n    }\n    51%,\n    100% {\n      opacity: 0;\n    }\n  }\n\n  /* Purple-themed gradient animations */\n  @keyframes purple-gradient {\n    0%,\n    100% {\n      background-position: 0% 50%;\n    }\n    50% {\n      background-position: 100% 50%;\n    }\n  }\n\n  @keyframes purple-glow {\n    0%,\n    100% {\n      box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);\n    }\n    50% {\n      box-shadow: 0 0 40px rgba(168, 85, 247, 0.6);\n    }\n  }\n\n  /* Updated gradient animations to match the reference image style */\n  @keyframes modern-gradient {\n    0% {\n      background-position: 0% 50%;\n    }\n    50% {\n      background-position: 100% 50%;\n    }\n    100% {\n      background-position: 0% 50%;\n    }\n  }\n\n  /* GitHub-inspired gradient backgrounds */\n  .gradient-github-primary {\n    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 25%, #0f3460 50%, #533483 75%, #8b5cf6 100%);\n    background-size: 400% 400%;\n    animation: modern-gradient 8s ease infinite;\n  }\n\n  .gradient-github-dark {\n    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 20%, #16213e 40%, #0f3460 60%, #533483 80%, #8b5cf6 100%);\n    background-size: 400% 400%;\n    animation: modern-gradient 10s ease infinite;\n  }\n\n  .gradient-github-accent {\n    background: linear-gradient(135deg, #533483 0%, #8b5cf6 25%, #a855f7 50%, #c084fc 75%, #ddd6fe 100%);\n    background-size: 400% 400%;\n    animation: modern-gradient 6s ease infinite;\n  }\n\n  .gradient-text-github {\n    background: linear-gradient(135deg, #8b5cf6, #a855f7, #c084fc, #ddd6fe);\n    background-clip: text;\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-size: 400% 400%;\n    animation: modern-gradient 4s ease infinite;\n  }\n\n  /* Added new hero gradient background */\n  .hero-gradient-bg {\n    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 20%, #16213e 40%, #0f3460 60%, #533483 80%, #8b5cf6 100%);\n    background-size: 400% 400%;\n    animation: modern-gradient 12s ease infinite;\n  }\n\n  /* GitHub-style cards and components */\n  .github-card {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 6px;\n    transition: all 0.3s ease;\n  }\n\n  .github-card:hover {\n    border-color: #a855f7;\n    box-shadow: 0 0 20px rgba(168, 85, 247, 0.2);\n    transform: translateY(-2px);\n  }\n\n  .github-button {\n    background: #8b5cf6;\n    border: 1px solid #7c3aed;\n    color: #ffffff;\n    border-radius: 6px;\n    transition: all 0.2s ease;\n  }\n\n  .github-button:hover {\n    background: #7c3aed;\n    box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);\n    transform: translateY(-1px);\n  }\n\n  .github-button-secondary {\n    background: #21262d;\n    border: 1px solid #30363d;\n    color: #f0f6fc;\n    border-radius: 6px;\n    transition: all 0.2s ease;\n  }\n\n  .github-button-secondary:hover {\n    background: #30363d;\n    border-color: #a855f7;\n  }\n\n  /* Animation classes */\n  .animate-fade-in-up {\n    animation: fade-in-up 0.8s ease-out forwards;\n  }\n\n  .animate-slide-in-left {\n    animation: slide-in-left 0.8s ease-out forwards;\n  }\n\n  .animate-scale-in {\n    animation: scale-in 0.6s ease-out forwards;\n  }\n\n  .animate-float {\n    animation: float 3s ease-in-out infinite;\n  }\n\n  .animate-github-glow {\n    animation: purple-glow 2s ease-in-out infinite;\n  }\n\n  .animate-typing-cursor {\n    animation: typing-cursor 1s infinite;\n  }\n\n  /* Staggered animation delays */\n  .animate-delay-100 {\n    animation-delay: 0.1s;\n  }\n  .animate-delay-200 {\n    animation-delay: 0.2s;\n  }\n  .animate-delay-300 {\n    animation-delay: 0.3s;\n  }\n  .animate-delay-400 {\n    animation-delay: 0.4s;\n  }\n  .animate-delay-500 {\n    animation-delay: 0.5s;\n  }\n  .animate-delay-600 {\n    animation-delay: 0.6s;\n  }\n  .animate-delay-700 {\n    animation-delay: 0.7s;\n  }\n  .animate-delay-800 {\n    animation-delay: 0.8s;\n  }\n\n  /* GitHub-style skill badges */\n  .skill-badge {\n    background: #21262d;\n    border: 1px solid #30363d;\n    color: #f0f6fc;\n    padding: 4px 8px;\n    border-radius: 12px;\n    font-size: 12px;\n    font-weight: 500;\n    transition: all 0.2s ease;\n  }\n\n  .skill-badge:hover {\n    background: #a855f7;\n    color: #0d1117;\n    transform: scale(1.05);\n  }\n\n  /* GitHub contribution graph inspired elements */\n  .contribution-square {\n    width: 12px;\n    height: 12px;\n    border-radius: 2px;\n    background: #21262d;\n    transition: all 0.2s ease;\n  }\n\n  .contribution-square.active {\n    background: #a855f7;\n    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);\n  }\n\n  /* Adding sliding skill cards animations */\n  @keyframes slide-cards-left {\n    0% {\n      transform: translateX(0);\n    }\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n\n  @keyframes slide-cards-right {\n    0% {\n      transform: translateX(-100%);\n    }\n    100% {\n      transform: translateX(0);\n    }\n  }\n\n  @keyframes skill-card-float {\n    0%,\n    100% {\n      transform: translateY(0px) scale(1);\n    }\n    50% {\n      transform: translateY(-5px) scale(1.02);\n    }\n  }\n\n  .skills-slider {\n    overflow: hidden;\n    position: relative;\n    width: 100%;\n  }\n\n  .skills-track {\n    display: flex;\n    width: 200%;\n    animation: slide-cards-left 20s linear infinite;\n  }\n\n  .skills-track:hover {\n    animation-play-state: paused;\n  }\n\n  .skill-card-sliding {\n    flex: 0 0 auto;\n    margin-right: 1rem;\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 8px;\n    padding: 1rem;\n    min-width: 200px;\n    transition: all 0.3s ease;\n    animation: skill-card-float 3s ease-in-out infinite;\n  }\n\n  .skill-card-sliding:hover {\n    border-color: #a855f7;\n    box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);\n    transform: translateY(-5px) scale(1.05);\n    animation-play-state: paused;\n  }\n\n  .skill-card-sliding.featured {\n    background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);\n    color: #ffffff;\n    border-color: #7c3aed;\n    box-shadow: 0 0 25px rgba(168, 85, 247, 0.4);\n  }\n\n  .skill-card-sliding.featured:hover {\n    box-shadow: 0 0 35px rgba(168, 85, 247, 0.6);\n  }\n\n  /* Staggered floating animation delays for skill cards */\n  .skill-card-sliding:nth-child(2n) {\n    animation-delay: -1s;\n  }\n  .skill-card-sliding:nth-child(3n) {\n    animation-delay: -2s;\n  }\n  .skill-card-sliding:nth-child(4n) {\n    animation-delay: -0.5s;\n  }\n\n  /* Adding mobile phone-style card designs */\n  @keyframes phone-screen-glow {\n    0%,\n    100% {\n      box-shadow: 0 0 30px rgba(168, 85, 247, 0.3), inset 0 0 20px rgba(168, 85, 247, 0.1);\n    }\n    50% {\n      box-shadow: 0 0 50px rgba(168, 85, 247, 0.5), inset 0 0 30px rgba(168, 85, 247, 0.2);\n    }\n  }\n\n  @keyframes mobile-ui-slide {\n    0% {\n      transform: translateY(10px);\n      opacity: 0;\n    }\n    100% {\n      transform: translateY(0);\n      opacity: 1;\n    }\n  }\n\n  /* Mobile phone mockup styles */\n  .mobile-phone-card {\n    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 20%, #16213e 40%, #0f3460 60%, #533483 80%, #8b5cf6 100%);\n    border-radius: 25px;\n    padding: 8px;\n    position: relative;\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);\n    animation: phone-screen-glow 3s ease-in-out infinite;\n    border: 2px solid #30363d;\n  }\n\n  .mobile-phone-card::before {\n    content: \"\";\n    position: absolute;\n    top: 15px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 60px;\n    height: 4px;\n    background: #30363d;\n    border-radius: 2px;\n  }\n\n  .mobile-phone-card::after {\n    content: \"\";\n    position: absolute;\n    top: 25px;\n    right: 20px;\n    width: 8px;\n    height: 8px;\n    background: #a855f7;\n    border-radius: 50%;\n    box-shadow: 0 0 10px rgba(168, 85, 247, 0.8);\n  }\n\n  .mobile-screen {\n    background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #21262d 100%);\n    border-radius: 20px;\n    padding: 20px;\n    min-height: 400px;\n    position: relative;\n    overflow: hidden;\n    border: 1px solid #30363d;\n  }\n\n  .mobile-status-bar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 8px 0;\n    border-bottom: 1px solid #30363d;\n    margin-bottom: 20px;\n    font-size: 12px;\n    color: #8b949e;\n  }\n\n  .mobile-app-header {\n    text-align: center;\n    margin-bottom: 30px;\n    animation: mobile-ui-slide 0.8s ease-out;\n  }\n\n  .mobile-app-title {\n    font-size: 24px;\n    font-weight: bold;\n    background: linear-gradient(135deg, #a855f7, #c084fc, #ddd6fe);\n    background-clip: text;\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    margin-bottom: 8px;\n  }\n\n  .mobile-app-subtitle {\n    color: #8b949e;\n    font-size: 14px;\n  }\n\n  .mobile-skill-list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    animation: mobile-ui-slide 1s ease-out 0.2s both;\n  }\n\n  .mobile-skill-item {\n    background: rgba(168, 85, 247, 0.1);\n    border: 1px solid rgba(168, 85, 247, 0.3);\n    border-radius: 12px;\n    padding: 12px 16px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    transition: all 0.3s ease;\n  }\n\n  .mobile-skill-item:hover {\n    background: rgba(168, 85, 247, 0.2);\n    border-color: #a855f7;\n    transform: translateX(5px);\n  }\n\n  .mobile-skill-name {\n    font-weight: 600;\n    color: #f0f6fc;\n    font-size: 14px;\n  }\n\n  .mobile-skill-percentage {\n    color: #a855f7;\n    font-weight: bold;\n    font-size: 14px;\n  }\n\n  .mobile-progress-bar {\n    width: 100%;\n    height: 4px;\n    background: rgba(168, 85, 247, 0.2);\n    border-radius: 2px;\n    margin-top: 8px;\n    overflow: hidden;\n  }\n\n  .mobile-progress-fill {\n    height: 100%;\n    background: linear-gradient(90deg, #a855f7, #c084fc);\n    border-radius: 2px;\n    transition: width 1s ease-out;\n    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);\n  }\n\n  /* Project cards with mobile-inspired design */\n  .mobile-project-card {\n    background: linear-gradient(135deg, #161b22 0%, #21262d 100%);\n    border: 1px solid #30363d;\n    border-radius: 20px;\n    padding: 24px;\n    position: relative;\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .mobile-project-card::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background: linear-gradient(90deg, #a855f7, #c084fc, #ddd6fe);\n  }\n\n  .mobile-project-card:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 20px 40px rgba(168, 85, 247, 0.2);\n    border-color: #a855f7;\n  }\n\n  .mobile-project-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n\n  .mobile-project-icon {\n    width: 48px;\n    height: 48px;\n    background: linear-gradient(135deg, #a855f7, #8b5cf6);\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);\n  }\n\n  .mobile-project-stats {\n    display: flex;\n    gap: 16px;\n    font-size: 12px;\n    color: #8b949e;\n  }\n\n  .mobile-project-stat {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  /* Enhanced skill cards with mobile UI inspiration */\n  .mobile-inspired-skill-card {\n    background: linear-gradient(135deg, #161b22 0%, #21262d 100%);\n    border: 1px solid #30363d;\n    border-radius: 16px;\n    padding: 20px;\n    position: relative;\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .mobile-inspired-skill-card::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 3px;\n    background: linear-gradient(90deg, #a855f7, #c084fc);\n  }\n\n  .mobile-inspired-skill-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 12px 24px rgba(168, 85, 247, 0.2);\n    border-color: #a855f7;\n  }\n\n  .mobile-skill-header {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 16px;\n  }\n\n  .mobile-skill-icon {\n    width: 32px;\n    height: 32px;\n    background: rgba(168, 85, 247, 0.2);\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .mobile-skill-category {\n    font-size: 18px;\n    font-weight: bold;\n    color: #f0f6fc;\n  }\n}\n"])</script><script>self.__next_f.push([1,"1f:T847b,"])</script><script>self.__next_f.push([1,"\"use client\"\n\nimport type React from \"react\"\nimport { useState, useEffect } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport { Input } from \"@/components/ui/input\"\nimport { Textarea } from \"@/components/ui/textarea\"\nimport {\n  Mail,\n  Phone,\n  MapPin,\n  Github,\n  Linkedin,\n  Download,\n  ExternalLink,\n  Code,\n  Music,\n  ChefHat,\n  Video,\n  Star,\n  GitBranch,\n  Users,\n  Calendar,\n} from \"lucide-react\"\n\nexport default function Portfolio() {\n  const [formData, setFormData] = useState({\n    name: \"\",\n    email: \"\",\n    message: \"\",\n  })\n\n  const handleInputChange = (e: React.ChangeEvent\u003cHTMLInputElement | HTMLTextAreaElement\u003e) =\u003e {\n    setFormData({\n      ...formData,\n      [e.target.name]: e.target.value,\n    })\n  }\n\n  const handleSubmit = (e: React.FormEvent) =\u003e {\n    e.preventDefault()\n    console.log(\"Form submitted:\", formData)\n  }\n\n  const skills = [\n    { name: \"HTML\", category: \"Frontend\", level: 90 },\n    { name: \"CSS\", category: \"Frontend\", level: 85 },\n    { name: \"JavaScript\", category: \"Frontend\", level: 88 },\n    { name: \"React.js\", category: \"Frontend\", level: 85 },\n    { name: \"Next.js\", category: \"Frontend\", level: 80 },\n    { name: \"Bootstrap\", category: \"Frontend\", level: 85 },\n    { name: \"jQuery\", category: \"Frontend\", level: 75 },\n    { name: \"React Native\", category: \"Mobile\", level: 80 },\n    { name: \"Android Studio\", category: \"Mobile\", level: 70 },\n    { name: \"Redux Toolkit\", category: \"State Management\", level: 75 },\n    { name: \"MySQL\", category: \"Backend\", level: 80 },\n    { name: \"Firebase\", category: \"Backend\", level: 85 },\n    { name: \"Strapi CMS\", category: \"Backend\", level: 75 },\n    { name: \"Git\", category: \"Tools\", level: 90 },\n    { name: \"GitHub\", category: \"Tools\", level: 90 },\n    { name: \"Postman\", category: \"Tools\", level: 85 },\n  ]\n\n  const experience = [\n    {\n      title: \"Software Engineer\",\n      company: \"Sthanave Technologies\",\n      period: \"2024 - Present\",\n      type: \"Full-time\",\n      description:\n        \"Working as a full-stack developer, building responsive web applications and mobile solutions using modern technologies.\",\n      achievements: [\"Built 5+ production applications\", \"Improved performance by 40%\", \"Led team of 3 developers\"],\n    },\n    {\n      title: \"Web Development Intern\",\n      company: \"Sthanave Technologies\",\n      period: \"2023 - 2024\",\n      type: \"Internship\",\n      description:\n        \"Completed comprehensive internship in web development, gaining hands-on experience with frontend and backend technologies.\",\n      achievements: [\"Completed 10+ projects\", \"Learned modern frameworks\", \"Collaborated with senior developers\"],\n    },\n  ]\n\n  const education = [\n    {\n      degree: \"Diploma in Computer Science Engineering\",\n      institution: \"Uday Prasad Uday Government Polytechnic Durg\",\n      period: \"2021 - 2022\",\n      grade: \"Completed\",\n    },\n    {\n      degree: \"Higher Secondary (12th)\",\n      institution: \"CG Board\",\n      period: \"2019 - 2020\",\n      grade: \"92%\",\n    },\n    {\n      degree: \"Secondary (10th)\",\n      institution: \"CG Board\",\n      period: \"2018 - 2019\",\n      grade: \"92%\",\n    },\n  ]\n\n  const projects = [\n    {\n      title: \"E-Commerce Web Application\",\n      description:\n        \"Built a full-stack e-commerce platform with React.js frontend and Firebase backend, featuring user authentication, product catalog, and shopping cart functionality.\",\n      technologies: [\"React.js\", \"Firebase\", \"CSS\", \"JavaScript\"],\n      github: \"#\",\n      live: \"#\",\n      stars: 24,\n      forks: 8,\n    },\n    {\n      title: \"Task Management Mobile App\",\n      description:\n        \"Developed a cross-platform mobile application using React Native for task management with offline capabilities and cloud synchronization.\",\n      technologies: [\"React Native\", \"Redux Toolkit\", \"Firebase\"],\n      github: \"#\",\n      live: \"#\",\n      stars: 18,\n      forks: 5,\n    },\n    {\n      title: \"Restaurant Management System\",\n      description:\n        \"Created a comprehensive restaurant management system with Strapi CMS backend, featuring menu management, order tracking, and customer management.\",\n      technologies: [\"Next.js\", \"Strapi CMS\", \"MySQL\", \"Bootstrap\"],\n      github: \"#\",\n      live: \"#\",\n      stars: 31,\n      forks: 12,\n    },\n  ]\n\n  const hobbies = [\n    { name: \"Cooking\", icon: ChefHat },\n    { name: \"Video Editing\", icon: Video },\n    { name: \"Listening to Music\", icon: Music },\n  ]\n\n  const [displayedName, setDisplayedName] = useState(\"\")\n  const [isTyping, setIsTyping] = useState(true)\n  const fullName = \"NEELAM GAYAKWAD\"\n\n  useEffect(() =\u003e {\n    let currentIndex = 0\n    const typingInterval = setInterval(() =\u003e {\n      if (currentIndex \u003c= fullName.length) {\n        setDisplayedName(fullName.slice(0, currentIndex))\n        currentIndex++\n      } else {\n        setIsTyping(false)\n        clearInterval(typingInterval)\n      }\n    }, 150)\n\n    return () =\u003e clearInterval(typingInterval)\n  }, [])\n\n  return (\n    \u003cdiv className=\"min-h-screen bg-background\"\u003e\n      \u003cnav className=\"fixed top-0 w-full bg-background/95 backdrop-blur-sm border-b border-border z-50\"\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\"\u003e\n          \u003cdiv className=\"flex justify-between items-center h-16\"\u003e\n            \u003cdiv className=\"font-bold text-xl text-foreground\"\u003e\n              {displayedName}\n              {isTyping \u0026\u0026 \u003cspan className=\"animate-typing-cursor text-accent\"\u003e|\u003c/span\u003e}\n            \u003c/div\u003e\n            \u003cdiv className=\"hidden md:flex space-x-8\"\u003e\n              {[\"Home\", \"About\", \"Skills\", \"Work\", \"Projects\", \"Contact\"].map((item) =\u003e (\n                \u003ca\n                  key={item}\n                  href={`#${item.toLowerCase()}`}\n                  className=\"text-muted-foreground hover:text-accent transition-colors duration-200 font-medium\"\n                \u003e\n                  {item}\n                \u003c/a\u003e\n              ))}\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/nav\u003e\n\n      \u003csection id=\"home\" className=\"pt-24 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden\"\u003e\n        \u003cdiv className=\"absolute inset-0 hero-gradient-bg\"\u003e\u003c/div\u003e\n        \u003cdiv className=\"absolute top-20 left-10 w-32 h-32 bg-accent/10 rounded-full animate-float\"\u003e\u003c/div\u003e\n        \u003cdiv className=\"absolute bottom-20 right-10 w-24 h-24 bg-primary/10 rounded-full animate-float animate-delay-300\"\u003e\u003c/div\u003e\n\n        \u003cdiv className=\"max-w-6xl mx-auto relative z-10\"\u003e\n          \u003cdiv className=\"grid md:grid-cols-2 gap-12 items-center\"\u003e\n            \u003cdiv className=\"animate-fade-in-up\"\u003e\n              \u003cdiv className=\"github-card p-8 mb-8 animate-github-glow\"\u003e\n                \u003cdiv className=\"w-20 h-20 gradient-github-primary rounded-full flex items-center justify-center text-2xl font-bold text-white mb-6\"\u003e\n                  NG\n                \u003c/div\u003e\n                \u003ch1 className=\"text-4xl md:text-6xl font-bold text-foreground mb-4 leading-tight\"\u003e\n                  \u003cspan className=\"gradient-text-github\"\u003e\n                    {displayedName}\n                    {isTyping \u0026\u0026 \u003cspan className=\"animate-typing-cursor text-accent\"\u003e|\u003c/span\u003e}\n                  \u003c/span\u003e\n                \u003c/h1\u003e\n                \u003cdiv className=\"inline-flex items-center gap-2 bg-accent/10 text-accent px-4 py-2 rounded-full font-semibold text-lg mb-6\"\u003e\n                  \u003cCode className=\"h-5 w-5\" /\u003e\n                  Software Engineer\n                \u003c/div\u003e\n                \u003cp className=\"text-muted-foreground text-lg leading-relaxed mb-8\"\u003e\n                  Web Developer focused on creating useful and effective websites and applications. Eager to take on new\n                  challenges and use creative thinking to build fast, responsive, and user-friendly web solutions.\n                \u003c/p\u003e\n              \u003c/div\u003e\n\n              \u003cdiv className=\"flex gap-4\"\u003e\n                \u003cButton className=\"github-button px-6 py-3 font-semibold\"\u003e\n                  \u003cMail className=\"mr-2 h-5 w-5\" /\u003e\n                  Hire Me\n                \u003c/Button\u003e\n                \u003cButton\n                  className=\"github-button-secondary px-6 py-3 font-semibold\"\n                  onClick={() =\u003e {\n                    const link = document.createElement(\"a\")\n                    link.href = \"/resume/neelam-gayakwad-resume.pdf\"\n                    link.download = \"Neelam_Gayakwad_Resume.pdf\"\n                    document.body.appendChild(link)\n                    link.click()\n                    document.body.removeChild(link)\n                  }}\n                \u003e\n                  \u003cDownload className=\"mr-2 h-5 w-5\" /\u003e\n                  Download CV\n                \u003c/Button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv className=\"animate-scale-in animate-delay-300\"\u003e\n              \u003cdiv className=\"github-card p-8\"\u003e\n                \u003ch3 className=\"text-2xl font-bold text-foreground mb-6 flex items-center gap-2\"\u003e\n                  \u003cUsers className=\"h-6 w-6 text-accent\" /\u003e\n                  Quick Stats\n                \u003c/h3\u003e\n                \u003cdiv className=\"grid grid-cols-2 gap-6\"\u003e\n                  \u003cdiv className=\"text-center\"\u003e\n                    \u003cdiv className=\"text-3xl font-bold text-accent mb-2\"\u003e1+\u003c/div\u003e\n                    \u003cdiv className=\"text-muted-foreground\"\u003eYears Experience\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"text-center\"\u003e\n                    \u003cdiv className=\"text-3xl font-bold text-accent mb-2\"\u003e15+\u003c/div\u003e\n                    \u003cdiv className=\"text-muted-foreground\"\u003eProjects Completed\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"text-center\"\u003e\n                    \u003cdiv className=\"text-3xl font-bold text-accent mb-2\"\u003e10+\u003c/div\u003e\n                    \u003cdiv className=\"text-muted-foreground\"\u003eTechnologies\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"text-center\"\u003e\n                    \u003cdiv className=\"text-3xl font-bold text-accent mb-2\"\u003e92%\u003c/div\u003e\n                    \u003cdiv className=\"text-muted-foreground\"\u003eAcademic Score\u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003csection id=\"skills\" className=\"py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden\"\u003e\n        \u003cdiv className=\"absolute inset-0 gradient-github-dark opacity-30\"\u003e\u003c/div\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto relative z-10\"\u003e\n          \u003cdiv className=\"text-center mb-16\"\u003e\n            \u003ch2 className=\"text-3xl md:text-5xl font-bold text-foreground mb-4\"\u003e\n              \u003cspan className=\"gradient-text-github\"\u003eSkills \u0026 Technologies\u003c/span\u003e\n            \u003c/h2\u003e\n            \u003cp className=\"text-muted-foreground text-lg max-w-2xl mx-auto\"\u003e\n              A comprehensive overview of my technical expertise and proficiency levels\n            \u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv className=\"mb-16 flex justify-center\"\u003e\n            \u003cdiv className=\"mobile-phone-card max-w-sm w-full\"\u003e\n              \u003cdiv className=\"mobile-screen\"\u003e\n                \u003cdiv className=\"mobile-status-bar\"\u003e\n                  \u003cspan\u003e9:41\u003c/span\u003e\n                  \u003cdiv className=\"flex items-center gap-1\"\u003e\n                    \u003cdiv className=\"w-4 h-2 bg-accent rounded-sm\"\u003e\u003c/div\u003e\n                    \u003cdiv className=\"w-1 h-1 bg-accent rounded-full\"\u003e\u003c/div\u003e\n                    \u003cdiv className=\"w-6 h-3 border border-accent rounded-sm\"\u003e\n                      \u003cdiv className=\"w-4 h-1 bg-accent rounded-sm m-0.5\"\u003e\u003c/div\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n\n                \u003cdiv className=\"mobile-app-header\"\u003e\n                  \u003cdiv className=\"mobile-app-title\"\u003eFrontend Skills\u003c/div\u003e\n                  \u003cdiv className=\"mobile-app-subtitle\"\u003eMy technical expertise\u003c/div\u003e\n                \u003c/div\u003e\n\n                \u003cdiv className=\"mobile-skill-list\"\u003e\n                  \u003cdiv className=\"mobile-skill-item\"\u003e\n                    \u003cdiv\u003e\n                      \u003cdiv className=\"mobile-skill-name\"\u003eHTML\u003c/div\u003e\n                      \u003cdiv className=\"mobile-progress-bar\"\u003e\n                        \u003cdiv className=\"mobile-progress-fill\" style={{ width: \"90%\" }}\u003e\u003c/div\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-skill-percentage\"\u003e90%\u003c/div\u003e\n                  \u003c/div\u003e\n\n                  \u003cdiv className=\"mobile-skill-item\"\u003e\n                    \u003cdiv\u003e\n                      \u003cdiv className=\"mobile-skill-name\"\u003eCSS\u003c/div\u003e\n                      \u003cdiv className=\"mobile-progress-bar\"\u003e\n                        \u003cdiv className=\"mobile-progress-fill\" style={{ width: \"85%\" }}\u003e\u003c/div\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-skill-percentage\"\u003e85%\u003c/div\u003e\n                  \u003c/div\u003e\n\n                  \u003cdiv className=\"mobile-skill-item\"\u003e\n                    \u003cdiv\u003e\n                      \u003cdiv className=\"mobile-skill-name\"\u003eJavaScript\u003c/div\u003e\n                      \u003cdiv className=\"mobile-progress-bar\"\u003e\n                        \u003cdiv className=\"mobile-progress-fill\" style={{ width: \"88%\" }}\u003e\u003c/div\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-skill-percentage\"\u003e88%\u003c/div\u003e\n                  \u003c/div\u003e\n\n                  \u003cdiv className=\"mobile-skill-item\"\u003e\n                    \u003cdiv\u003e\n                      \u003cdiv className=\"mobile-skill-name\"\u003eReact.js\u003c/div\u003e\n                      \u003cdiv className=\"mobile-progress-bar\"\u003e\n                        \u003cdiv className=\"mobile-progress-fill\" style={{ width: \"85%\" }}\u003e\u003c/div\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-skill-percentage\"\u003e85%\u003c/div\u003e\n                  \u003c/div\u003e\n\n                  \u003cdiv className=\"mobile-skill-item\"\u003e\n                    \u003cdiv\u003e\n                      \u003cdiv className=\"mobile-skill-name\"\u003eNext.js\u003c/div\u003e\n                      \u003cdiv className=\"mobile-progress-bar\"\u003e\n                        \u003cdiv className=\"mobile-progress-fill\" style={{ width: \"80%\" }}\u003e\u003c/div\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv className=\"mobile-skill-percentage\"\u003e80%\u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\