=\"font-bold text-lg text-foreground\"\u003eReact.js\u003c/h4\u003e\n                      \u003cp className=\"text-sm text-muted-foreground\"\u003eFrontend Framework\u003c/p\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"w-full bg-secondary rounded-full h-2 mb-2\"\u003e\n                    \u003cdiv className=\"gradient-github-accent h-2 rounded-full\" style={{ width: \"85%\" }}\u003e\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cp className=\"text-xs text-muted-foreground\"\u003eModern UI development with hooks and context\u003c/p\u003e\n                \u003c/div\u003e\n\n                \u003cdiv className=\"skill-card-sliding\"\u003e\n                  \u003cdiv className=\"flex items-center gap-3 mb-3\"\u003e\n                    \u003cdiv className=\"w-10 h-10 gradient-github-primary rounded-lg flex items-center justify-center\"\u003e\n                      \u003cCode className=\"h-5 w-5 text-white\" /\u003e\n                    \u003c/div\u003e\n                    \u003cdiv\u003e\n                      \u003ch4 className=\"font-bold text-lg text-foreground\"\u003eNext.js\u003c/h4\u003e\n                      \u003cp className=\"text-sm text-muted-foreground\"\u003eFull-stack Framework\u003c/p\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cdiv className=\"w-full bg-secondary rounded-full h-2 mb-2\"\u003e\n                    \u003cdiv className=\"gradient-github-accent h-2 rounded-full\" style={{ width: \"80%\" }}\u003e\u003c/div\u003e\n                  \u003c/div\u003e\n                  \u003cp className=\"text-xs text-muted-foreground\"\u003eServer-side rendering and API routes\u003c/p\u003e\n                \u003c/div\u003e\n\n                \u003cdiv className=\"skill-card-sliding\"\u003e\n                  \u003cdiv className=\"flex items-center gap-3 mb-3\"\u003e\n                    \u00